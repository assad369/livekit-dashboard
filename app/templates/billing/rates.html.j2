{% extends "base.html.j2" %}

{% block title %}Rates — LiveKit Dashboard{% endblock %}
{% block page_title %}Rate card{% endblock %}
{% block page_subtitle %}
<p class="text-muted mb-0">Used to estimate what your traffic would cost on LiveKit Cloud</p>
{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-4">
  <div class="row">
    <div class="col-lg-9">

      {% if card.needs_verification %}
      <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-1"></i>
        These are LiveKit's published entry-tier figures, not confirmed for your
        account. Check them against
        <a href="{{ card.source_url }}" target="_blank" rel="noopener">livekit.io/pricing</a>
        and save to clear this warning.
      </div>
      {% elif card.verified_on %}
      <div class="alert alert-success py-2">
        <i class="bi bi-check-circle me-1"></i>
        Confirmed {{ card.verified_on }}{% if card.updated_by %} by {{ card.updated_by }}{% endif %}.
      </div>
      {% endif %}

      {% if not storage_available %}
      <div class="alert alert-warning">
        Set <code>MONGODB_URI</code> to save a rate card. Defaults are shown below.
      </div>
      {% endif %}

      <form method="post" action="/billing/rates" class="card">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <div class="card-body">

          <h6 class="mb-3">Pricing model</h6>
          <p class="text-muted small">
            LiveKit moved from per-participant-minute billing to a bandwidth-based
            model. Pick whichever applies to the account you are comparing against.
          </p>
          <div class="mb-4">
            <div class="form-check">
              <input class="form-check-input" type="radio" name="pricing_model" id="model-bw"
                     value="bandwidth" {% if card.pricing_model == 'bandwidth' %}checked{% endif %}>
              <label class="form-check-label" for="model-bw">
                Bandwidth <span class="text-muted small">(current — metered on downstream GB)</span>
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="pricing_model" id="model-pm"
                     value="participant_minute"
                     {% if card.pricing_model == 'participant_minute' %}checked{% endif %}>
              <label class="form-check-label" for="model-pm">
                Participant minutes <span class="text-muted small">(legacy)</span>
              </label>
            </div>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-3">
              <label class="form-label small">Currency</label>
              <input type="text" name="currency" class="form-control form-control-sm"
                     value="{{ card.currency }}" maxlength="8">
            </div>
            <div class="col-md-3">
              <label class="form-label small">Per downstream GB</label>
              <input type="number" step="0.000001" name="bandwidth_gb_usd"
                     class="form-control form-control-sm" value="{{ card.bandwidth_gb_usd }}">
            </div>
            <div class="col-md-3">
              <label class="form-label small">Per participant minute</label>
              <input type="number" step="0.000001" name="participant_minute_usd"
                     class="form-control form-control-sm" value="{{ card.participant_minute_usd }}">
            </div>
            <div class="col-md-3">
              <label class="form-label small">Monthly platform fee</label>
              <input type="number" step="0.01" name="monthly_platform_fee_usd"
                     class="form-control form-control-sm"
                     value="{{ card.monthly_platform_fee_usd }}">
            </div>
          </div>

          <h6 class="mb-3">Included allowances</h6>
          <div class="row g-3 mb-4">
            <div class="col-md-3">
              <label class="form-label small">Included GB / month</label>
              <input type="number" step="0.01" name="included_bandwidth_gb"
                     class="form-control form-control-sm" value="{{ card.included.bandwidth_gb }}">
            </div>
            <div class="col-md-3">
              <label class="form-label small">Included minutes / month</label>
              <input type="number" step="1" name="included_participant_minutes"
                     class="form-control form-control-sm"
                     value="{{ card.included.participant_minutes }}">
            </div>
          </div>

          <h6 class="mb-3">Egress — per minute</h6>
          <div class="row g-3 mb-4">
            {% for key, label in [
                ('room_composite', 'Room composite'), ('participant', 'Participant'),
                ('track', 'Track'), ('track_composite', 'Track composite'), ('web', 'Web')] %}
            <div class="col-md-2">
              <label class="form-label small">{{ label }}</label>
              <input type="number" step="0.000001" name="egress_{{ key }}"
                     class="form-control form-control-sm"
                     value="{{ card.egress_minute_usd.get(key, 0) }}">
            </div>
            {% endfor %}
          </div>

          <h6 class="mb-3">Ingress — per minute</h6>
          <div class="row g-3 mb-4">
            {% for key, label in [('rtmp', 'RTMP'), ('whip', 'WHIP'), ('url', 'URL')] %}
            <div class="col-md-2">
              <label class="form-label small">{{ label }}</label>
              <input type="number" step="0.000001" name="ingress_{{ key }}"
                     class="form-control form-control-sm"
                     value="{{ card.ingress_minute_usd.get(key, 0) }}">
            </div>
            {% endfor %}
          </div>

          <h6 class="mb-3">Your actual cost</h6>
          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label small">Server cost per month</label>
              <input type="number" step="0.01" name="vps_monthly_cost_usd"
                     class="form-control form-control-sm"
                     value="{{ card.vps_monthly_cost_usd }}">
              <div class="form-text">
                What you pay for the VPS running LiveKit. This is the other side of
                the comparison.
              </div>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-sm"
                  {% if is_readonly() or not storage_available %}disabled{% endif %}>
            Save rate card
          </button>
          <a href="/billing" class="btn btn-secondary btn-sm">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}
